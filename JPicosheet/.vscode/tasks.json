{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "ビルドしてテスト (AllTests)",
			"type": "process",
			"command": "powershell.exe",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build-test.ps1"],
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "ビルドのみ",
			"type": "process",
			"command": "powershell.exe",
			"args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\build-test.ps1", "-BuildOnly"],
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": []
		}
	]
}
